# ====================================
# ShopyMarket — Variables de Entorno para Docker
# ====================================
# INSTRUCCIONES:
#   1. Copia este archivo como .env:  cp .env.docker .env
#   2. Edita los valores según tu entorno
#   3. NUNCA subas .env a git (ya está en .gitignore)
#
# NOTA: Las variables con valores por defecto ya funcionan
#       para desarrollo local con Docker.
# ====================================

# ---- PostgreSQL (Base de Datos) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1010
POSTGRES_DB=ShopyMarket_DB

# Puerto externo de PostgreSQL (solo para conectar desde tu PC, no producción)
DB_EXTERNAL_PORT=5432

# ---- Backend (Node.js/Express) ----
BACKEND_PORT=3000
BACKEND_EXTERNAL_PORT=3000

# JWT Secret — ¡CAMBIA ESTO EN PRODUCCIÓN!
JWT_SECRET=shopymarket_jwt_secret_2026_secure

# Entorno de la aplicación (local | docker | production)
APP_ENVIRONMENT=docker

# URLs del sitio (ajusta con tu dominio en producción)
# Producción: SITE_URL=https://www.shopymarketmv.com
# Producción: API_URL=https://api.shopymarketmv.com
SITE_URL=http://localhost
API_URL=http://localhost/api

# CORS — Orígenes permitidos (separados por coma)
# En desarrollo: dejar vacío permite todo
# En producción: CORS_ORIGIN=https://www.shopymarketmv.com
CORS_ORIGIN=

# ---- Email (Brevo/Sendinblue) ----
BREVO_API_KEY=tu_api_key_aqui
BREVO_SENDER_EMAIL=tu_email@ejemplo.com
BREVO_SENDER_NAME=ShopyMarket
EMAIL_DEV_MODE=true

# ---- Super Admin (usuario inicial) ----
SUPERADMIN_EMAIL=root@root.com
SUPERADMIN_PASSWORD=Root123!
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin
SUPERADMIN_PHONE=+0000000000

# ---- Frontend (Vite Build Args) ----
# Puerto público del frontend (el que usas en el navegador)
FRONTEND_PORT=80

# URL del API para el build de Vite
# Docker local con Nginx proxy: dejar vacío (usa rutas relativas)
# Vercel producción: VITE_API_URL=https://api.shopymarketmv.com
VITE_API_URL=
VITE_AUTH_LOGIN_PATHS=/auth/login,/api/auth/login,/login
VITE_AUTH_REGISTER_PATHS=/auth/register,/api/auth/register,/register
